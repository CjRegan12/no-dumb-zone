{
  "description": "no-dumb-zone: hand off past NDZ_LIMIT, brief the next session from NOTES.md, and hold every session to NORTHSTAR.md",
  "modules": [
    "./register.ts"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/ndz-check.js"
            ],
            "timeout": 20,
            "statusMessage": "no-dumb-zone: checking context size"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/ndz-northstar.js"
            ],
            "timeout": 10,
            "statusMessage": "no-dumb-zone: checking the north star"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/ndz-allow-handoff.js"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/ndz-pickup.js"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/ndz-northstar.js"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
